<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pot.us-stock-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>-lc</string>
        <string>cd /Users/pot/automation/us-stock-daily &amp;&amp; /usr/bin/python3 generate_report.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/pot/automation/us-stock-daily</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/pot/.bun/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/pot/automation/us-stock-daily/logs/us-stock-daily.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pot/automation/us-stock-daily/logs/us-stock-daily.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
